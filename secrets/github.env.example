# The tracker's GitHub App. Copy to github.env and fill in.
#
# The private key does NOT go here — save the .pem GitHub gives you as
# ./secrets/github-app.pem instead. A PEM is multi-line and env files turn
# that into one mangled line.

# From the app's settings page, "App ID".
TRACKER_GITHUB_APP_ID=

# The name in its URL: github.com/apps/<this>. Powers the Connect button.
TRACKER_GITHUB_APP_SLUG=

# Any long random string. Paste the SAME value into the app's webhook secret.
# Without it the webhook refuses every delivery, deliberately.
TRACKER_GIT_WEBHOOK_SECRET=
